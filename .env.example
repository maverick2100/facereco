# ---------------------------------------------------------------- models / ANE
FR_SCRFD_MODEL=models/scrfd.mlpackage
FR_ARCFACE_MODEL=models/arcface.mlpackage
# CPU_AND_NE = Neural Engine + CPU fallback, never GPU (recommended)
# ALL | CPU_AND_NE | CPU_ONLY | CPU_AND_GPU
FR_COMPUTE_UNITS=CPU_AND_NE
FR_CACHE_COMPILED=true
FR_WARMUP_ITERS=3
# Only used when the model input is a MultiArray (ImageType models normalise internally)
FR_SCRFD_MEAN=127.5
FR_SCRFD_STD=128.0
FR_SCRFD_SIGMOID=false
FR_ARCFACE_MEAN=127.5
FR_ARCFACE_STD=127.5

# ---------------------------------------------------------------- detection
FR_DET_THRESHOLD=0.5
FR_NMS_THRESHOLD=0.4
FR_MIN_FACE_SIZE=40
FR_MAX_FACES=20
FR_DET_BATCH=4
FR_DET_MAX_WAIT_MS=8
FR_MAX_FRAME_AGE_S=1.0

# ---------------------------------------------------------------- recognition
FR_MATCH_THRESHOLD=0.45
FR_MATCH_MARGIN=0.05
FR_REC_BATCH=16
FR_REC_MAX_WAIT_MS=10
FR_REC_QUEUE=256
FR_BLUR_THRESHOLD=40
FR_MAX_YAW=0.45
FR_MIN_QUALITY=0.25
FR_EVENT_COOLDOWN_S=10
FR_RECORD_UNKNOWN=true
FR_UNKNOWN_COOLDOWN_S=30
FR_UNKNOWN_SIMILARITY=0.5
# Skip ArcFace for faces overlapping a recently identified face (big ANE saving)
FR_TRACK_IOU=0.45
FR_TRACK_REVERIFY_S=2.0
FR_GALLERY_RELOAD_S=30

# ---------------------------------------------------------------- ingestion
# auto | gstreamer | opencv
FR_INGESTION_BACKEND=auto
FR_RECONNECT_DELAY_S=2
FR_RECONNECT_MAX_DELAY_S=60
FR_STALE_TIMEOUT_S=15
FR_QUEUE_DEPTH=1
FR_CAMERAS_FILE=config/cameras.yaml

# ---------------------------------------------------------------- storage
FR_DB_PATH=data/face_recognition.db
FR_SAVE_SNAPSHOTS=false
FR_SNAPSHOT_QUALITY=85
FR_EVENT_FLUSH_S=1.0
FR_EVENT_BATCH=100
FR_EVENT_QUEUE=5000
FR_RETENTION_DAYS=90

# ---------------------------------------------------------------- monitoring
FR_HEALTH_HOST=127.0.0.1
FR_HEALTH_PORT=8085
FR_HEALTH_INTERVAL_S=30
FR_POWERMETRICS=true
FR_LOG_LEVEL=INFO
FR_LOGGING_CONFIG=config/logging.yaml
